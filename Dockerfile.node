# Multi-stage build for Node.js MCP servers
FROM node:22-alpine AS builder

# Build argument for package name
ARG PACKAGE

WORKDIR /app

# Copy root package files
COPY package*.json ./
COPY tsconfig.json ./

# Copy packages
COPY packages/shared ./packages/shared
COPY packages/${PACKAGE} ./packages/${PACKAGE}

# better-sqlite3 (used by the auth service) is a native module — the Alpine
# builder needs a toolchain to compile it. Build-only; not copied to production.
RUN apk add --no-cache python3 make g++

# Install all dependencies (including dev dependencies for building)
RUN npm ci

# Create symlink for workspace package (npm ci doesn't handle partial workspaces)
RUN mkdir -p node_modules/@access-mcp && \
    ln -sf ../../packages/shared node_modules/@access-mcp/shared

# Build shared first, then the target package
RUN npx tsc --build packages/shared
RUN npx tsc --build packages/${PACKAGE}

# Production stage
FROM node:22-alpine AS production

ARG PACKAGE
ENV PACKAGE=${PACKAGE}

WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S mcp && \
    adduser -S mcp -u 1001

# The auth service's client store persists to a volume mounted at /data. Create
# the dir owned by the non-root runtime user so a freshly-mounted named volume
# is writable (an absent mountpoint would default to root:root -> EACCES). This
# dir is unused by the other servers built from this shared image (harmless).
RUN mkdir -p /data && chown mcp:mcp /data

# Copy built application
COPY --from=builder --chown=mcp:mcp /app/packages/shared ./packages/shared
COPY --from=builder --chown=mcp:mcp /app/packages/${PACKAGE} ./packages/${PACKAGE}
COPY --from=builder --chown=mcp:mcp /app/node_modules ./node_modules

USER mcp

EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "console.log('Server healthy')" || exit 1

# Start the server with telemetry bootstrap loaded first
# The --import flag ensures OpenTelemetry is initialized before express/http are loaded
CMD ["sh", "-c", "node --import ./packages/shared/dist/telemetry-bootstrap.js packages/${PACKAGE}/dist/index.js"]